# Server port (Railway sets this automatically)
PORT=3000

# PostgreSQL — set by Railway automatically, or paste a connection string for local dev
DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT signing secret — use a long random string (e.g. openssl rand -hex 32)
# (legacy — unused once the Firebase Auth migration is live; kept so old tokens
#  in flight during the cutover still fail closed rather than erroring out)
JWT_SECRET=your-very-long-random-secret-here

# Firebase Admin SDK — path to the service account JSON downloaded from
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Anthropic Claude API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (optional — for OTP phone verification)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google OAuth (optional — for Google sign-in)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Welcome emails (optional) — use Gmail with an App Password
# Gmail: myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
