# Server port (Cloud Run sets this automatically; 3000 locally if unset)
PORT=3000

# PostgreSQL — Neon connection string (pooled, ?sslmode=require), or leave unset to use
# local Postgres over its Unix socket. PG_POOL_MAX (optional, default 3) sizes the pool.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Signs the one-click unsubscribe links in emails: a long random string
# (e.g. openssl rand -hex 32); don't change it once emails have gone out
JWT_SECRET=your-very-long-random-secret-here

# Firebase Admin SDK — path to the service account JSON downloaded from
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# ...or the key's JSON itself (raw or base64), e.g. from Secret Manager:
# FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or neither: Application Default Credentials (Cloud Run) + the project id.
# Only ID-token checks are done, so the project id alone is enough.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Anthropic Claude API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Welcome emails (optional) — use Gmail with an App Password
# Gmail: myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password

# Welcome emails via Resend (optional; no email is sent when unset)
RESEND_API_KEY=
